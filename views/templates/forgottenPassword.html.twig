{% extends "layout.html.twig" %}

{% block title %}
      Miaou | Réinitialisation du mot de passe
{% endblock %}

{% block body %}

  {% block header %}
    {{ parent() }}
  {% endblock %}

  {% block content %}
    {% block error %}{% endblock %}

    <section id="forgotten-password" class="forgotten-content">
      <h2 class="sr-only">Formulaire de réinitialisation de mot de passe</h2>

      <article id="forgotten-form" class="form" role="form" aria-labelledby="forgotten-title">
        <h3 id="forgotten-title">
          Pour réinitialiser votre mot de passe :<br aria-hidden="true"> Renseignez votre adresse email
        </h3>

        <form method="POST" action="?route=forgottenPassword" class="forgotten-form" novalidate aria-describedby="forgotten-description">
          <div class="container-forgotten">
            <legend class="sr-only">Informations de réinitialisation</legend>

            <label for="firstname">Prénom <span aria-label="requis" class="required">*</span></label>
            <input type="text" id="firstname" name="firstname" aria-describedby="error-firstname" required>
            <div class="error-message" id="error-firstname" role="alert" aria-live="polite"></div>

            <label for="email">Email <span aria-label="requis" class="required">*</span></label>
            <input type="email" id="email" name="email" aria-describedby="error-email" required>
            <div class="error-message" id="error-email" role="alert" aria-live="polite"></div>

            <input type="hidden" name="csrf_token" id="csrf_token" value="{{ csrf_token }}">
            <div class="error-message" id="error-csrf_token" role="alert" aria-live="assertive"></div>

            <div class="submit-button">
              <input type="submit" class="register-btn" name="soumettre" value="Réinitialiser mon mot de passe" aria-label="Réinitialiser mon mot de passe Miaou">
            </div>
          </div>
        </form>
      </article>
    </section>
  {% endblock %}
{% endblock %}
